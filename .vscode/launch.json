{
  // Run and Debug 面板（⇧⌘D）里那个下拉框读的就是这个文件。
  // ⚠️ 任务（tasks.json）**不在**这个面板里 —— 它归 Terminal → Run Task… 管。
  //
  // ⚠️ 要能真跑起来，得装 Python 扩展（它带 debugpy）：
  //    code --install-extension ms-python.python
  //    没装的话，这些配置会**列在下拉框里但点不动**（报 "debug type 'debugpy' is not supported"）。
  //
  // ⚠️ 这里**不是事实源**：入口命令的事实源仍是 README.md。
  // ⚠️ 跑批 / 单测的调试配置**暂缺** —— 测试工具还没随迁；补齐后照样式加回来。
  "version": "0.2.0",
  "configurations": [
    {
      // 🔴 console 必须是 integratedTerminal：app.chat 要 stdin（待答时要打字），
      //    internalConsole 里打不了字，会卡死在 input()。
      "name": "① 交互式对话（app.chat）",
      "type": "debugpy",
      "request": "launch",
      "module": "app.chat",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    },
    {
      "name": "② 单轮对话（sxagent --say）",
      "type": "debugpy",
      "request": "launch",
      "module": "sxagent",
      "args": ["--say", "${input:sayText}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "sayText",
      "type": "promptString",
      "description": "这一轮说什么？",
      "default": "帮我备课，三年级数学"
    }
  ]
}

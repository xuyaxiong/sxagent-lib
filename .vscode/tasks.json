{
  // 点着跑 —— 不用敲指令。
  //
  // ⚠️ 这里**不是事实源**：每条命令的事实源是 README.md。
  //    改入口命令时，两处一起改 —— 否则这里会静默跑起一条没人维护的老命令。
  //
  // 怎么点：Terminal → Run Task…（或 Cmd+Shift+P → "Tasks: Run Task"）→ 选一条。
  //        Cmd+Shift+B 直接跑默认「打包」。
  // ⚠️ 跑批 / 单测任务**暂缺** —— 测试工具还没随迁（模板见旧仓库 .vscode/tasks.json）；
  //    测试补齐后照样式加回来。
  "version": "2.0.0",
  "tasks": [
    {
      // 最常用。跑在集成终端里，所以「待答」时可以直接打字回复（不是只读输出）。
      "label": "① 交互式对话（app.chat）",
      "type": "shell",
      "command": "uv run python -m app.chat",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // 快速冒烟：模型连没连上 / 技能在不在。说完一句就退出，不留交互。
      "label": "② 单轮对话（sxagent --say）",
      "type": "shell",
      "command": "uv run python -m sxagent --say \"${input:sayText}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // → dist/sxagent/（单目录，不是单文件）。⚠️ 上一个包还在跑时必须用 --out 换目录。
      "label": "③ 打包（build_cli.py → dist/sxagent/）",
      "type": "shell",
      "command": "uv run python build_cli.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sayText",
      "type": "promptString",
      "description": "这一轮说什么？",
      "default": "帮我备课，三年级数学"
    }
  ]
}
